# Copy to .env.local. Restart `npm run dev` after changes.

# true  = use the built-in demo data and demo accounts (no backend needed)
# false = call the real backend through the proxy below
NEXT_PUBLIC_USE_MOCKS=true

# Server-side proxy targets (the backends have no CORS, so the browser calls /api and /media
# on the Next.js origin and Next.js forwards them here).
API_PROXY_TARGET=http://127.0.0.1:8001
MEDIA_PROXY_TARGET=http://127.0.0.1:8002
